# Vyakhya Environment Configuration
# Copy to .env and customize

# App Settings
APP_NAME=Vyakhya
APP_VERSION=0.1.0
ENVIRONMENT=development

# Security
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=vyakhya

# Model Registry
MODEL_REGISTRY_PATH=./model_registry

# Detection Engine
TEXT_MODEL_TIMEOUT_MS=200
TEXT_MODEL_PRIMARY=distilbert-base-multilingual-cased
TEXT_MODEL_FALLBACK=tfidf_lr
ENABLE_HF_MODEL=true

# Tier Cutoffs (calibrated from data)
TIER_LOW_MAX=39
TIER_MEDIUM_MAX=69
TIER_HIGH_MAX=84

# Soft-Hold Policy
SOFT_HOLD_ENABLED=true
SOFT_HOLD_AUTO_EXPIRY_MINUTES=30
DUAL_REVIEW_THRESHOLD=85

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
